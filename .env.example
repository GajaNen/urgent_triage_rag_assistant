# Required: used for triage reasoning (RAGBase/rag.py) and LLM evaluation.
OPENAI_API_KEY=your-openai-api-key

# Optional: NCBI E-utilities API key, for higher rate limits on the optional
# live PubMed lookup in retrieval.py (search_ncbi). Works without it too.
NCBI_API_KEY=

# Optional: comma-separated OpenAI models to compare in evaluate_llm.py.
# Defaults to "gpt-4o-mini,gpt-4o" if unset.
EVAL_MODELS=gpt-4o-mini,gpt-4o
